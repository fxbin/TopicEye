# ═══════════════════════════════════════════════════════════════
# TopicEye 生产环境配置模板
# ═══════════════════════════════════════════════════════════════
#
# 用法：
#   cp backend/.env.production backend/.env
#   nano backend/.env  # 填入你的值
#   sudo ./deploy/deploy.sh
#
# 重要：所有标注 [必填] 的项必须设置，否则服务无法正常启动
# ═══════════════════════════════════════════════════════════════

# ── 运行时 [必填] ─────────────────────────────────────────────
APP_ENV=production

# 用于加密用户集成密钥（如 WeRead API Key），必须设为一个随机长字符串
# 生成命令: openssl rand -hex 32
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# ── 数据库 ────────────────────────────────────────────────────
# 生产用 PostgreSQL（docker-compose.prod.yml 自带 postgres 容器）
DATABASE_URL=postgresql+asyncpg://topiceye:topiceye@postgres:5432/topiceye

# 如果不用 Docker 自带 PG，改为你自己的数据库地址：
# DATABASE_URL=postgresql+asyncpg://user:password@your-db-host:5432/topiceye

# ── DuckDB 分析层 ─────────────────────────────────────────────
# 4C4G 服务器推荐配置
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_EXTENSION_DIR=./data/duckdb_extensions
DUCKDB_STARTUP_INIT_ENABLED=false

# ── 启动行为 ──────────────────────────────────────────────────
AUTO_CREATE_TABLES_ON_STARTUP=true
STARTUP_SEED_ENABLED=true

# 可选：启动时自动创建管理员账号 [推荐首次部署启用]
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@topiceye.local
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_DISPLAY_NAME=TopicEye Admin

# ── 调度器 ────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SOURCE_SYNC_TIMEOUT_SECONDS=120
RSS_SCRAPER_TIMEOUT_SECONDS=15

# ── CORS [必填] ───────────────────────────────────────────────
# 替换为你的实际域名
# 无 SSL: http://your-domain.com
# 有 SSL: https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# ── OAuth 登录（可选）─────────────────────────────────────────
# Google 登录
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub 登录
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# OAuth 登录成功后前端回调页
OAUTH_FRONTEND_REDIRECT_URL=https://your-domain.com/oauth/callback

# ── 速率限制 ──────────────────────────────────────────────────
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=20
AUTH_REGISTER_ATTEMPTS_PER_MINUTE=10
LLM_REQUESTS_PER_MINUTE=30

# ── 站内阅读 ──────────────────────────────────────────────────
ARTICLE_READER_ENABLED=true
ARTICLE_READER_FETCH_TIMEOUT_SECONDS=12
ARTICLE_READER_TOTAL_TIMEOUT_SECONDS=16
ARTICLE_READER_MAX_RESPONSE_BYTES=1500000
ARTICLE_READER_SNAPSHOT_TTL_SECONDS=86400

# ── 微信读书 ──────────────────────────────────────────────────
# 后端直连微信读书官方 gateway，用户在前端填写 API Key 即可

# ── 微博热搜（可选）───────────────────────────────────────────
# 仅在游客系统被风控时设置登录态 SUB cookie
# WEIBO_SUB_COOKIE=

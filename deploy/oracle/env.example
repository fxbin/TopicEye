# Copy to the repository root as .env; never commit the populated file.
# Replace every CHANGE_ME before deployment.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://topiceye:CHANGE_ME_URL_ENCODED@postgres:5432/topiceye
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
INTEGRATION_SECRET_KEY=CHANGE_ME_GENERATE_ANOTHER_OPENSSL_RAND_HEX_32

# Public site is exposed ONLY through Cloudflare Tunnel -> NPM -> frontend.
CORS_ORIGINS=https://topic.textura.top
SITE_BASE_URL=https://topic.textura.top
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
OAUTH_FRONTEND_REDIRECT_URL=https://topic.textura.top/oauth/callback

# Conservative defaults for the shared 2-vCPU Oracle host.
DUCKDB_THREADS=1
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_STARTUP_INIT_ENABLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
SOURCE_SYNC_WORKER_CONCURRENCY=1
TRENDING_SYNC_CONCURRENCY=2
CACHE_WARMUP_ENABLED=false
AUTO_CREATE_TABLES_ON_STARTUP=true
STARTUP_SEED_ENABLED=true
SCHEDULER_ENABLED=true
LLM_COMPLETION_TIMEOUT_SECONDS=45

# Initial admin bootstrap (enable only if needed; disable after first login).
ADMIN_SEED_ENABLED=false
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# Optional OAuth (configure matching callback URLs at the provider).
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Compose limits; tune after measuring.
TOPICEYE_BACKEND_MEM_LIMIT=1536m
TOPICEYE_FRONTEND_MEM_LIMIT=768m
TOPICEYE_BACKEND_CPUS=1.0
TOPICEYE_FRONTEND_CPUS=0.75

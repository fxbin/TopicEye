# TopicEye Frontend Configuration
# Copy this to .env.local and fill in your values.
# All variables are optional — defaults work for local development.

# ── Backend URL (server-side, used by Next.js rewrites) ──
# The Next.js dev server proxies /api/* to this backend.
# Default points to the local backend on port 8102.
# In Docker, set this to http://backend:8000 (the compose service name).
BACKEND_API_URL=http://127.0.0.1:8102

# ── Public API URL (client-side, exposed to the browser) ──
# Leave unset to use the relative "/api/v1" path (goes through the Next.js
# rewrite above). Only set this if the frontend talks to the backend directly
# (e.g. deployed separately, bypassing the Next.js proxy).
# NEXT_PUBLIC_API_URL=https://api.topiceye.example.com/api/v1

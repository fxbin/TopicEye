# TopicEye Backend Configuration
# Copy this to .env and fill in your values

# Runtime
APP_ENV=development

# Database
# PostgreSQL is the only supported backend. Use Docker (`make dev-db`) for local dev.
DATABASE_URL=postgresql+asyncpg://topiceye:topiceye@localhost:5432/topiceye
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_EXTENSION_DIR=./data/duckdb_extensions
# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600

# Startup behavior
AUTO_CREATE_TABLES_ON_STARTUP=true
STARTUP_SEED_ENABLED=true
# Optional startup admin seed. Enable and set these in your local .env when you
# want the backend to create or promote an admin account on startup.
ADMIN_SEED_ENABLED=false
# ADMIN_EMAIL=admin@topiceye.local
# ADMIN_PASSWORD=change-this-admin-password
# ADMIN_DISPLAY_NAME=TopicEye Admin
# Required when APP_ENV=production. Used to encrypt user integration secrets.
# INTEGRATION_SECRET_KEY=replace-with-a-long-random-secret
SCHEDULER_ENABLED=true
SOURCE_SYNC_TIMEOUT_SECONDS=120
# 单次 RSS fetch 超时(秒)。原硬编码 30s 偏长,慢站(Wired 等)会拖到上面 120s 同步超时。
# 默认 15s 给慢站快速 fail 释放 worker,真正重要的慢站可在 source 表的 settings 里覆写。
RSS_SCRAPER_TIMEOUT_SECONDS=15

# 站内阅读：仅抓取公开 HTML，并且不会使用登录态、代理、验证码或反爬绕过。
ARTICLE_READER_ENABLED=true
ARTICLE_READER_FETCH_TIMEOUT_SECONDS=12
ARTICLE_READER_TOTAL_TIMEOUT_SECONDS=16
ARTICLE_READER_MAX_RESPONSE_BYTES=1500000
# PDF 原文体积上限（PDF 比 HTML 大约 10 倍；超出会回退到外链）
ARTICLE_READER_MAX_PDF_BYTES=8000000
ARTICLE_READER_SNAPSHOT_TTL_SECONDS=86400
# 可选：只允许指定域名（逗号分隔）。为空时仍会拦截内网/保留地址。
# ARTICLE_READER_ALLOWED_HOSTS=example.com,blog.example.org

# CORS — comma-separated frontend origins allowed to call the API.
# config.py 默认留空（不允许任何跨域），必须在 .env 中显式设置。
# 本地开发用 localhost:3000；生产环境替换为实际域名。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM routes are configured in the model management UI/API.
# Runtime reads enabled rows from llm_models ordered by routing_group/routing_priority.

# Session management
# Session 有效期（天），默认 30 天
SESSION_DAYS=30
# 滑动续期阈值（天）：剩余有效期低于此值时自动续期。设为 0 可禁用。
SESSION_REFRESH_THRESHOLD_DAYS=7

# Auth cookie（HttpOnly，防 XSS 窃取 token）
# HTTPS 部署必须设 AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Rate limiting
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=20
AUTH_REGISTER_ATTEMPTS_PER_MINUTE=10
AUTH_REFRESH_ATTEMPTS_PER_MINUTE=20
LLM_REQUESTS_PER_MINUTE=30
# 单次模型调用硬截止时间；模型配置中的 extra_params.litellm_params.timeout 只能缩短。
LLM_COMPLETION_TIMEOUT_SECONDS=45
# 预算熔断：按实际 DONE 调用数的三窗保险丝（分钟/小时/日），超限拒绝新付费调用，
# 分析链路自动走本地降级（卡片标「本地速览·待 AI 复核」），预算余量 >30% 时由
# requeue job 自动补分析；窗口滚过后恢复。0 = 关闭对应窗口（代码默认全关，opt-in）。
LLM_BUDGET_CALLS_PER_MINUTE=60
LLM_BUDGET_CALLS_PER_HOUR=2000
LLM_BUDGET_CALLS_PER_DAY=20000
#
# 数值校准依据（2026-09-30 圆桌，四席对照；实测负载：日峰 5865 / 时峰 508 / 分峰 24）：
#   现阶段维持 60/2000/20000——圆桌裁决：requeue 补分析刚落地（#90）、
#   尚未稳定运行观察，误触发代价（本地降级）未完全可逆前天平向宽松；
#   灾难场景仍有 3.4x+ 余量。
#   SRE 席建议收紧 70/1500/10000-12000：限流 30/min 下时窗 2000 数学上不可达（持续上限 1800/h）；
#   成本席建议收紧 60/1200/10000：全旗舰路由最坏 ¥240-3600/日，次数上限锁不住金额上限；
#   产品席偏松 60/3000/20000：误触发=降级，代价不可逆时宁可松；
#   数据席维持 60/2000/20000：现值对正常流量零误伤；relation_discovery 9 天涨 3.6 倍，日窗最怕增长而非异常。
#   收紧前提：requeue 补分析（已随 #90 落地）稳定运行后，可收紧至 60/1200/10000 并加 10k 告警线；
#   切换付费 API 后建议二期增加金额三窗（当前 total_cost 记账未实现，暂无数据可依）。
# 预算豁免场景（逗号分隔）：低频核心承诺场景不做预算检查，防日报在日窗耗尽时硬失败。
LLM_BUDGET_EXEMPT_SCENES=daily_report,weekly_digest,monthly_digest

# OAuth (Google / GitHub 登录)
# provider 凭据（client_id / client_secret / 启用开关）自 #94 起存数据库，
# 由管理员在后台 /admin/settings「第三方登录」面板配置，保存后即时生效，
# 不再走 .env。历史 .env 中的 OAUTH_GOOGLE_*/OAUTH_GITHUB_* 会在迁移时
# 自动导入数据库，之后可从 .env 删除。
#
# Google: https://console.cloud.google.com/ → APIs & Services → Credentials
#   → Create OAuth 2.0 Client ID (Web application)
#   Authorized redirect URI: http://localhost:8102/api/v1/auth/oauth/google/callback
# GitHub: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Authorization callback URL: http://localhost:8102/api/v1/auth/oauth/github/callback
#
# OAuth 登录成功后前端回调页（token 走 URL fragment 传回）
# config.py 默认留空；启用 OAuth 时必须在 .env 中设置。
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/oauth/callback

# Agent config
AGENT_MAX_STEPS=10
AGENT_TEMPERATURE=0.3
AGENT_MAX_RETRIES=3

# 微信读书素材同步
# 后端直连微信读书官方 gateway（i.weread.qq.com），无需额外配置。
# 用户只需在前端个人中心填写 API Key（格式 wrk-xxxxxxxx）即可同步。

# 微博热搜：默认通过 Sina Visitor System 自动获取临时游客 cookie，无需配置。
# 仅在游客系统被风控（IP 黑名单等）时，可手动设置登录态 SUB cookie 作为 fallback。
# WEIBO_SUB_COOKIE=

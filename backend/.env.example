# TopicEye Backend Configuration
# Copy this to .env and fill in your values

# Runtime
APP_ENV=development

# Database
# SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./topiceye.db
# PostgreSQL switch:
# DATABASE_URL=postgresql+asyncpg://topiceye:topiceye@postgres:5432/topiceye
# Optional experimental SQLite domain split. Keep false unless a migration plan
# handles cross-domain relationships explicitly.
DATABASE_SQLITE_DOMAIN_SPLIT_ENABLED=false
DATABASE_SQLITE_DOMAIN_DIR=./data/domains
# SQLite 写锁等待（毫秒）。默认 30s；批量写场景临时用 BATCH 值快速返回 503
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_BUSY_TIMEOUT_BATCH_MS=500
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_EXTENSION_DIR=./data/duckdb_extensions

# Startup behavior
AUTO_CREATE_TABLES_ON_STARTUP=true
STARTUP_SEED_ENABLED=true
# Optional startup admin seed. Enable and set these in your local .env when you
# want the backend to create or promote an admin account on startup.
ADMIN_SEED_ENABLED=false
# ADMIN_EMAIL=admin@topiceye.local
# ADMIN_PASSWORD=change-this-admin-password
# ADMIN_DISPLAY_NAME=TopicEye Admin
# Required when APP_ENV=production. Used to encrypt user integration secrets.
# INTEGRATION_SECRET_KEY=replace-with-a-long-random-secret
SCHEDULER_ENABLED=true
SOURCE_SYNC_TIMEOUT_SECONDS=120

# CORS — comma-separated frontend origins allowed to call the API.
# Defaults cover the local Next.js dev server (port 3000).
# Set this to your deployed frontend origin(s) in production, e.g.
# CORS_ORIGINS=https://topiceye.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM routes are configured in the model management UI/API.
# Runtime reads enabled rows from llm_models ordered by routing_group/routing_priority.

# Rate limiting
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=20
AUTH_REGISTER_ATTEMPTS_PER_MINUTE=10
LLM_REQUESTS_PER_MINUTE=30

# Agent config
AGENT_MAX_STEPS=10
AGENT_TEMPERATURE=0.3
AGENT_MAX_RETRIES=3
